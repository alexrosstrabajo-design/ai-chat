# For local dev: copy this file to .env and fill in your real key.
# For production on Vercel: set these in the Vercel dashboard
#   (Project -> Settings -> Environment Variables), NOT via this file.
#
# Get a free Groq key at https://console.groq.com
GROQ_API_KEY=your_key_here

# Model to use. Defaults to openai/gpt-oss-120b (llama-3.3-70b-versatile was discontinued).
GROQ_MODEL=openai/gpt-oss-120b
